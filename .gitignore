# Entorno virtual
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Compilados PyInstaller
dist/
build/
*.spec

# Base de datos (datos reales)
*.db
*.db-shm
*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal
backups/
*.bak
*.backup

# Uploads de usuarios (contenido subido en tiempo de ejecucion, no versionado).
# OJO: no usar un patron "uploads/" que excluya todo el directorio -- git no
# permite des-excluir archivos dentro de un directorio ya excluido en bloque,
# y uploads/logos/ (mas abajo) SI debe versionarse: el filesystem de Railway
# es efimero, y si el logo no viaja en el repo se pierde en cada deploy.
uploads/fotos/
uploads/*.jpg
uploads/*.jpeg
uploads/*.png
uploads/*.webp

# Variables de entorno
.env
.env.*
!.env.example

# Config local de MCP (referencia project_ref de Supabase, no es secreto pero es local)
.mcp.json

# Licencias (artefactos locales con datos sensibles)
license.key
license_*.txt
*.key
.lic_data

# Ejecutables
*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dependencias frontend
node_modules/

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Archivos basura generados accidentalmente
*.txt.bak
Procfile (*)
*.gitignore.txt
