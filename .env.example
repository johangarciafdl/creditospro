# ============================================================
# CreditosPro v2.1 — Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores
# IMPORTANTE: NUNCA subas el archivo .env al repositorio
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Usa tu propia conexión de Supabase/PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/basedatos
DATABASE_URL=postgresql://usuario:contraseña@host:5432/basedatos

# Opcional: conexión con un rol de Postgres restringido (sin BYPASSRLS) para
# que las políticas RLS aíslen de verdad por empresa_id. Si se configura,
# también activa ENABLE_DATABASE_RLS=1. Si se omite, la app usa DATABASE_URL
# para todo (igual que antes). Ver rls_policies.sql para crear el rol.
DATABASE_URL_APP=

# ── Seguridad ────────────────────────────────────────────────
# Genera una clave aleatoria fuerte (mínimo 32 caracteres)
# Puedes generarla con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TU_SECRET_KEY_AQUI

# Clave para cookies de sesión (diferente a SECRET_KEY)
SESSION_SECRET_KEY=TU_SESSION_SECRET_KEY_AQUI

# ── Licencia ─────────────────────────────────────────────────
# La activación es por empresa (clave comercial), no por máquina.
# Genérala con: python crear_clave_empresa.py --empresa-id <id>
# El cliente la ingresa en /license/activar.

# ── WhatsApp / Green API (opcional) ───────────────────────────
# La configuración real por empresa se guarda en la tabla `configuracion`
# (panel /whatsapp), no aquí. Estas variables no las lee actualmente
# ninguna ruta de envío; quedan para un futuro valor de arranque por defecto.
WP_PHONE_ID=
WP_TOKEN=

# ── Servidor ─────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8000
AUTO_CREATE_TABLES=1
DEFAULT_COMPANY_NAME=CreditosPro
ALLOW_PUBLIC_REGISTRATION=0
PURCHASE_URL=
SOFTWARE_NAME=CreditosPro
SOFTWARE_OWNER=Tu Nombre
ENABLE_SEED_DATA=0
INITIAL_ADMIN_PASSWORD=

# 1 = no abrir navegador automáticamente al iniciar (recomendado en
# servidores). 0 = abrir navegador.
CREDITOSPRO_NO_BROWSER=1

# ── Plantilla de conexión (opcional) ─────────────────────────
# Si necesitas crear una nueva empresa, crear_empresa.py usa esta
# plantilla para construir la DATABASE_URL.
DATABASE_URL_TEMPLATE=

# ── Entorno ──────────────────────────────────────────────────
# development | production
ENVIRONMENT=production
# Activar solo despues de aplicar rls_policies.sql y probar con un rol sin BYPASSRLS
ENABLE_DATABASE_RLS=0

# ── Supabase Storage (fotos de clientes y evidencias de cobro) ──────────────
# Las imagenes viven en un bucket privado llamado "imagenes". Sin estas dos
# variables la aplicacion sigue funcionando: guarda los bytes en la columna
# archivos.datos, que es lo que hace en desarrollo y en las pruebas.
# La clave de servicio salta RLS: es solo de servidor y nunca debe llegar al
# navegador. Se saca del panel de Supabase, en Project Settings > API keys.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_IMAGENES=imagenes
SUPABASE_BUCKET_RESPALDOS=respaldos
