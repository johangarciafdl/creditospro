# ============================================================
# CreditosPro v2.1 — Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores
# IMPORTANTE: NUNCA subas el archivo .env al repositorio
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Usa tu propia conexión de Supabase/PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/basedatos
DATABASE_URL=postgresql://postgres.kfwlrjrysapcgkdvicss:Jo681192*hjk@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ── Seguridad ────────────────────────────────────────────────
# Genera una clave aleatoria fuerte (mínimo 32 caracteres)
# Puedes generarla con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=hUwmfhk2wmUhSklJty5WvqpjmcJmnnettvN3rZ7nsOOLKibJq4w_HGu8p6w6_oxo

# Clave para cookies de sesión (diferente a SECRET_KEY)
SESSION_SECRET_KEY=vz5qgeICSztHVkMm6ih4cxsJ0igE8QXhFAVr0Q-87QlvhZcBw04AIH3Kytdfn6c4

# ── Licencia ─────────────────────────────────────────────────
# Clave maestra para validación de licencia (license_manager.py,
# owner_tool.py). Si falta, la app NO arranca.
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LICENSE_MASTER_KEY=CREDITOSPRO-JOHAN-GARCIA-2024-MASTER-KEY-ULTRA-SEGURA

# Clave de licencia específica de esta empresa (activar_licencia.py).
# Si no la pones, la tendrás que pasar con --key al ejecutar el script.
CREDITOSPRO_LICENSE_KEY=

# ── WhatsApp API (opcional) ──────────────────────────────────
WP_API_KEY=
WP_PHONE_ID=
WP_TOKEN=

# ── Servidor ─────────────────────────────────────────────────
# Puerto donde corre la aplicación
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AUTO_CREATE_TABLES=1
DEFAULT_COMPANY_NAME=ElRusso
ALLOW_PUBLIC_REGISTRATION=0
SOFTWARE_NAME=CreditosPro
SOFTWARE_OWNER=Johan Garcia
ENABLE_SEED_DATA=0

# 1 = no abrir navegador automáticamente al iniciar (recomendado en
# servidores). 0 = abrir navegador.
CREDITOSPRO_NO_BROWSER=1

# ── Plantilla de conexión (opcional) ─────────────────────────
# Si necesitas crear una nueva empresa, crear_empresa.py usa esta
# plantilla para construir la DATABASE_URL. Incluye el esquema de
# Supabase (postgres.xxxxx) y un usuario con permisos.
DATABASE_URL_TEMPLATE=postgresql://kfwlrjrysapcgkdvicss:Jo681192*hjk@host:5432/postgres

# ── Entorno ──────────────────────────────────────────────────
# development | production
ENVIRONMENT=production
